        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "GNURUST.INTRINSIC.CASE.1 non-claim: multibyte/UTF-8 REVERSE"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "GNURUST.INTRINSIC.CASE.1 non-claim: all dialects"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "GNURUST.INTRINSIC.CASE.1 non-claim: lie prevented: UPPER-CASE uppercases everything -- NO: only ASCII a-z fold (digits/spaces/punctuation and any non-ASCII byte are UNCHANGED), and REVERSE reverses raw BYTES including trailing spaces (not a logical trim-then-reverse)"
          }
        }
      ]
