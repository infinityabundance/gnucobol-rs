{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "kobold-casefile",
          "informationUri": "https://github.com/infinityabundance",
          "version": "1",
          "rules": [
            {
              "id": "NONCLAIM",
              "shortDescription": {
                "text": "A surface this court explicitly does NOT prove (fail-closed / out of scope)."
              }
            },
            {
              "id": "VERDICT",
              "shortDescription": {
                "text": "The court's replay verdict."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "VERDICT",
          "level": "note",
          "message": {
            "text": "SUPPORT-PACKET.1 verdict=pass"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "SUPPORT-PACKET.1 non-claim: new truth/evidence"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "SUPPORT-PACKET.1 non-claim: certification"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "SUPPORT-PACKET.1 non-claim: regulatory compliance"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "SUPPORT-PACKET.1 non-claim: production approval"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "SUPPORT-PACKET.1 non-claim: customer acceptance"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "SUPPORT-PACKET.1 non-claim: a live/current state (it is a snapshot)"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "SUPPORT-PACKET.1 non-claim: lie prevented: 'here is the support packet, therefore the system is certified/compliant/approved' -- SUPPORT-PACKET.1 only collects existing generated artifacts and claims nothing new"
          }
        }
      ]
    }
  ]
}