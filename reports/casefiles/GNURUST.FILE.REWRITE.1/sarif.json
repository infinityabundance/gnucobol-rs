          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "GNURUST.FILE.REWRITE.1 non-claim: length-changing rewrites"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "GNURUST.FILE.REWRITE.1 non-claim: DELETE"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
