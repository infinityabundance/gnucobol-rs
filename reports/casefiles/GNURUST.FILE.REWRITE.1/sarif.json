          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "GNURUST.FILE.REWRITE.1 non-claim: read-before-rewrite sequencing/status"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "GNURUST.FILE.REWRITE.1 non-claim: all dialects"
          }
        },
        {
          "ruleId": "NONCLAIM",
          "level": "note",
          "message": {
            "text": "GNURUST.FILE.REWRITE.1 non-claim: lie prevented: REWRITE rewrites the whole file -- NO: it overwrites ONLY the current record in place (same length); the bytes of every other record are untouched, so a REWRITE is a surgical single-record update not a file rewrite"
          }
        }
      ]
    }
  ]
