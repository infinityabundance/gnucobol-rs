               DISPLAY "UNEXPECTED HEX-VALUE OF 'HI! ': " HEXX.
 
            SET  HEXX-FILLER TO TRUE
            STRING FUNCTION HEX-OF (BIN) DELIMITED BY SIZE INTO HEXX.
            IF HEXX NOT = "0000000C--"
