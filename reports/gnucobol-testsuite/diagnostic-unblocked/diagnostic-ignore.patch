        >>ELIF CHARSET = 'EBCDIC'
            IF HEXX NOT = "40F0F1F2--"
        >>ELSE
            IF 1 = 1 DISPLAY 'CHARSET UNKNOWN! PLEASE REPORT!'
        >>END-IF
