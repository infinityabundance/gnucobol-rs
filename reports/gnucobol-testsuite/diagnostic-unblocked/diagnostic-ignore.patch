            SET  HEXX-FILLER TO TRUE
            STRING FUNCTION HEX-OF (Y) DELIMITED BY SIZE INTO HEXX.
        >>IF   CHARSET = 'ASCII'
            IF HEXX NOT = "48492E20--"
        >> ELSE
