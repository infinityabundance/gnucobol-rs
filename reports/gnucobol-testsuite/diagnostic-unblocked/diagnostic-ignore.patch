 AT_SETUP([EXIT PARAGRAPH])
 AT_KEYWORDS([runmisc])
 
 # Note: testing EXIT PARAGRPAPH without being PERFORMed
 #       implicit GO TO only
 
 AT_DATA([prog.cob], [
        IDENTIFICATION   DIVISION.
        PROGRAM-ID.      prog.
        DATA             DIVISION.
        WORKING-STORAGE  SECTION.
        01 INDVAL        PIC 9(4).
        PROCEDURE        DIVISION.
        A01.
            PERFORM VARYING INDVAL FROM 1 BY 1 UNTIL INDVAL > 10
             IF INDVAL > 2
                EXIT PARAGRAPH
             END-IF
