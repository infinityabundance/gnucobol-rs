# Build artifacts
/target
**/target
Cargo.lock

# Admitted upstream + built oracle (re-fetchable / re-buildable, never vendored)
/lab/admit/
/lab/oracle/prefix/
/lab/oracle/prefix-312/
/lab/oracle/prefix-*/
/lab/oracle/*.log
/lab/oracle/build/
/lab/**/*.o
/lab/**/*.so
/lab/**/decimal_harness

# Admitted source bundle + local porting-method corpus (re-fetchable / private working notes;
# never published — the method corpus is local-only and out of this project's scope).
/research/

# Fuzz
/crates/*/fuzz/target
/crates/*/fuzz/corpus
/crates/*/fuzz/artifacts
lab/oracle/ebcdic_harness
lab/oracle/getopt_harness
reports/lineage20m/full-run/
lab/doxygen/out/
lab/doxygen/out-rust/
# port-index line-numbered symbol indexes are regenerable intermediates (churn on every source edit);
# the stable joined verdict reports/port-index/parity-detailed.json IS tracked.
reports/port-index/libcob-symbols.json
reports/port-index/rust-symbols.json
lab/oracle/cconv_harness
lab/oracle/intrinsic_harness

# CCVS85 corpus: keep the compressed spine, ignore the 27MB decompressed expansion
lab/corpus/ccvs85/newcob.val
reports/ccvs85/newcob.val

# COBOL corpus atlas: large raw corpora are re-downloadable from permanent sources; commit custody only.
lab/corpus/x-cobol/
lab/corpus/gcobol/
lab/corpus/opencbs/

# Front-end (cobrun) sweep file-I/O artifacts: the oracle writes pNN.dat into the repo root when a
# corpus program does file I/O; they are regenerated by the sweep and never committed.
/p[0-9]*.dat
/lab/oracle/src*
