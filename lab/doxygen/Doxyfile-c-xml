# Fast XML-only doxygen of the PINNED GnuCOBOL 3.2 libcob source — the machine-readable function
# inventory consumed by `xtask doxygen-compare` (the C-vs-Rust coverage gate). No HTML, no dot graphs,
# so it regenerates in the verification guard cheaply. The browsable HTML/call-graph map is the separate
# lab/doxygen/Doxyfile. Run: doxygen lab/doxygen/Doxyfile-c-xml
PROJECT_NAME           = "GnuCOBOL 3.2 libcob (pinned oracle, XML)"
OUTPUT_DIRECTORY       = lab/doxygen/out
INPUT                  = lab/admit/gnucobol-3.2/libcob
FILE_PATTERNS          = *.c *.h
RECURSIVE              = YES
# document everything, including the static helpers the port must reproduce
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
EXTRACT_LOCAL_METHODS  = YES
# output: XML only
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
# preprocessor: predefine the GMP path so the real code is parsed (matches Doxyfile)
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = HAVE_GMP_H=1 COB_LIB_EXPIMP= COB_EXPIMP= COB_A_INLINE= COB_INLINE=
