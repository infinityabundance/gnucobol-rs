      *> COMPUTE/arith ROUNDED MODE IS <mode> -- all eight modes, exact ties on .5. Identical to cobc 3.2.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. P155.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 R PIC S9(3) VALUE 0.
       PROCEDURE DIVISION.
           COMPUTE R ROUNDED MODE TRUNCATION = 2.9. DISPLAY "TR=[" R "]".
           COMPUTE R ROUNDED MODE NEAREST-AWAY-FROM-ZERO = 2.5. DISPLAY "NA=[" R "]".
           COMPUTE R ROUNDED MODE NEAREST-EVEN = 2.5. DISPLAY "NE1=[" R "]".
           COMPUTE R ROUNDED MODE NEAREST-EVEN = 3.5. DISPLAY "NE2=[" R "]".
           COMPUTE R ROUNDED MODE NEAREST-TOWARD-ZERO = 2.5. DISPLAY "NT=[" R "]".
           COMPUTE R ROUNDED MODE AWAY-FROM-ZERO = 2.1. DISPLAY "AW=[" R "]".
           COMPUTE R ROUNDED MODE TOWARD-GREATER = -2.5. DISPLAY "TG=[" R "]".
           COMPUTE R ROUNDED MODE TOWARD-LESSER = -2.1. DISPLAY "TL=[" R "]".
           DIVIDE 3 INTO 10 GIVING R ROUNDED MODE NEAREST-EVEN. DISPLAY "DV=[" R "]".
           STOP RUN.
